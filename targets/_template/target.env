# ============================================================================
# Target profile: __TARGET__
# This file is the whole contract between the lab and one audited project.
# `make detect TARGET=__TARGET__` proposes most of it; you confirm and fill the rest.
# ============================================================================
COMPOSE_PROJECT_NAME=seclab___TARGET__
TARGET_NAME=__TARGET__

# ---- source ----------------------------------------------------------------
# Absolute path to a checkout you already have. Preferred: no SSH keys enter a
# container (lab finding L2). Use REPO_URL+BRANCH with `make clone` only when you
# do not have the code locally, and then with a DEDICATED read-only deploy key.
SRC_PATH=/absolute/path/to/repo
#REPO_URL=ssh://git@host:2222/group/project.git
#BRANCH=develop
#DEPLOY_KEY=./configs/deploy_key

# Your code vs vendored code. Feeds sonar.sources; keep vendor/node_modules out.
SOURCE_DIRS=.
# Comma-separated: py,php,js,go  -> decides which linters apply.
LANGS=

# ---- static analysis -------------------------------------------------------
# QODANA_IMAGE vacío = "resuélvelo tú" (tools/qodana-image.sh lo elige a partir de LANGS).
# Antes vacío significaba "salto declarado", y como resultado la dimensión no corrió en NINGÚN
# proyecto: nadie rellena a mano el nombre exacto de una imagen que además depende de la licencia.
#   <imagen>  fija una concreta.       none  desactiva la dimensión a propósito.
# Las imágenes `-community` (python, jvm, android) corren sin token; las de release (php, js, go,
# dotnet) exigen QODANA_TOKEN de Qodana Cloud, y sin él la dimensión se reporta NO DISPONIBLE —
# nunca como aprobada. Comentarios ENCIMA de la variable, nunca tras el valor: compose lee un
# `# ...` final como parte del VALOR (ver tools/lib-env.sh).
QODANA_IMAGE=
# Explicit rulesets (--config=auto would require telemetry to be on).
SEMGREP_CONFIG=--config=p/security-audit --config=p/secrets --config=p/owasp-top-ten
SONAR_PORT=9000
SONAR_TOKEN=
QODANA_TOKEN=

# ---- runtime (only needed for dast / perf / e2e) ---------------------------
# BASE_URL          : as seen from the HOST (curl, Playwright with network_mode: host)
# APP_INTERNAL_URL  : as seen from ANOTHER container on the compose network (ZAP, k6)
# HEALTH_PATH       : returns 200 only when the app is genuinely serving.
#                     Without it you cannot tell "no findings" from "nothing was running".
BASE_URL=http://localhost:8099
APP_INTERNAL_URL=http://app:8000
HEALTH_PATH=/health
FRONTEND_URL=
ALLOWED_ORIGIN=

# ---- authentication --------------------------------------------------------
# Which adapter in lib/auth/ describes how this app logs in.
# sanctum | moodle-session | jwt-bearer | basic | none
AUTH_ADAPTER=none

# TWO accounts of DIFFERENT privilege, with known passwords. This is not optional:
# authorization is the one dimension no scanner can test for you, and it needs a
# low-privilege account to attempt what only the high-privilege one may do.
# high privilege (admin / instructor / manager)
ROLE_A_USER=
ROLE_A_PASS=
# low privilege (regular user / student)
ROLE_B_USER=
ROLE_B_PASS=

# ---- database (if the runtime needs one) -----------------------------------
DB_IMAGE=postgres:17
DB_NAME=audit
DB_USER=postgres
DB_PASSWORD=admin01

# ---- gate thresholds (make gate exits != 0 when breached) ------------------
ALLOW_SECRETS=0
MAX_DEP_FINDINGS=50
MAX_SAST_FINDINGS=50
K6_P95_MS=1500
K6_ERR_RATE=0.01

# ---- declared resource envelope --------------------------------------------
# Load numbers are only comparable against a stated envelope. Record it here and
# enforce it with `deploy.resources.limits` in compose.runtime.yml.
PERF_CPUS=4
PERF_MEM=1536m

# DAST alert budget (make gate).
MAX_DAST_FINDINGS=40
