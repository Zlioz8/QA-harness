# Escalera de carga de __TARGET__ (make perf-escalera TARGET=__TARGET__). Datos, no código.
# Cada paso es una corrida de k6 con N usuarios; se sube solo si el paso cumple el SLO.
ESCALERA_TIPO=carga
ESCALERA_SCRIPT=smoke.js
ESCALERA_PASOS=5 10 25 50
ESCALERA_RAMPA=30s
ESCALERA_MESETA=2m
ESCALERA_BAJADA=10s
ESCALERA_PAUSA_S=20
# Pasos que se siguen corriendo DESPUÉS del primer incumplimiento (0 = parar). Más de cero solo
# contra un despliegue propio: contra uno compartido es hacer daño sin aprender nada.
ESCALERA_SIGUE=0
# El SLO sale de target.env (K6_P95_MS, K6_P99_MS, K6_ERR_RATE, K6_CHECKS_MIN). Para otro:
#SLO_P95_MS=1500
#SLO_ERR_RATE=0.01
