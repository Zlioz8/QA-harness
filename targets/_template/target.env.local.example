# Plantilla del override local de este perfil.
#
#   cp target.env.local.example target.env.local     y rellena los valores
#
# target.env.local NO se versiona (.gitignore: targets/*/target.env.local). Es el único sitio
# donde viven la dirección del despliegue de validación y las credenciales de las cuentas de
# prueba. El target.env de al lado se versiona: documenta QUÉ variables existen y qué significan.
#
# Se carga ENCIMA de target.env: el Makefile pasa los dos --env-file a docker compose (el último
# gana), cada servicio lo declara como env_file opcional, y tools/lib-env.sh lo consulta primero.
# Una clave VACÍA aquí no anula el contrato: para tapar una clave se le da valor, para heredarla
# se la omite.
#
# Sin este archivo el perfil sigue siendo válido: las dimensiones [code] corren igual y las
# [live] se detienen en require-live en vez de fingir que pasaron.

# ---- runtime ---------------------------------------------------------------
# BASE_URL          : donde responde el despliegue, visto desde ESTE host (curl, Playwright).
# APP_INTERNAL_URL  : el mismo destino visto desde OTRO contenedor (ZAP, k6). Si la aplicación
#                     corre en este equipo: http://host.docker.internal:<puerto>
BASE_URL=
APP_INTERNAL_URL=
FRONTEND_URL=
ALLOWED_ORIGIN=

# Certificado autofirmado en el despliegue de validación: sin esto k6 aborta el 100% de las
# peticiones con x509 y el resultado se confunde con una aplicación caída.
#K6_INSECURE_SKIP_TLS_VERIFY=true

# ---- authentication --------------------------------------------------------
# Dos cuentas de DISTINTO privilegio. A = máximo, B = mínimo.
ROLE_A_USER=
ROLE_A_PASS=
ROLE_B_USER=
ROLE_B_PASS=
