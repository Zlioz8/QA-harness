# ============================================================================
# Target profile: antiplagio  (Moodle plugin + FastAPI + Kafka + Docker analyzers)
#
# This is the profile that proved the lab was not yet project-agnostic. Nothing here
# resembles costos_web: no SPA, no framework that boots on its own (the plugin lives
# inside a Moodle), two languages, and a message broker.
# ============================================================================
COMPOSE_PROJECT_NAME=seclab_antiplagio
TARGET_NAME=antiplagio

# ---- source ----------------------------------------------------------------
# Local checkout: no SSH key ever enters a container (lab finding L2).
SRC_PATH=/opt/MANUALES DE DESPLIEGUE WITH REPORT/ANTIPLAGIO/antiplagio
REPO_URL=ssh://git@git.fsrisaralda.com:2222/fabrica_zajuna/antiplagio.git
BRANCH=dev

# Four components in one repo. antiplagio/ holds the plugin, API, producer and analyzer;
# the antiplagio_web* dirs hold the web-flow variants.
SOURCE_DIRS=antiplagio,antiplagio_web,antiplagio_web_backend,antiplagio_producer_web
LANGS=py,php

# ---- static analysis -------------------------------------------------------
# Python is the majority language, so Qodana runs its Python linter. PHP coverage comes
# from SonarQube + semgrep instead — a single Qodana image cannot do both.
QODANA_IMAGE=jetbrains/qodana-python:latest
# Explicit rulesets (--config=auto would require telemetry to be on).
SEMGREP_CONFIG=--config=p/security-audit --config=p/secrets --config=p/owasp-top-ten
SONAR_PORT=9000
SONAR_TOKEN=
QODANA_TOKEN=

# ---- runtime ---------------------------------------------------------------
# Two front doors: the Moodle that hosts the plugin (the user-facing surface) and the
# FastAPI service (the machine-facing surface). They need separate ZAP contexts.
BASE_URL=http://localhost:8081
APP_INTERNAL_URL=http://moodle:80
API_URL=http://localhost:8030
API_INTERNAL_URL=http://api:8030
HEALTH_PATH=/login/index.php
FRONTEND_URL=
ALLOWED_ORIGIN=http://localhost:8081
MOODLE_PORT=8081
API_PORT=8030

# ---- authentication --------------------------------------------------------
# Moodle has no JSON login endpoint: the form is guarded by a one-shot logintoken and
# every write by a per-session sesskey. See lib/auth/index.ts.
AUTH_ADAPTER=moodle-session
# Role A = instructor (sees every learner's report). Role B = learner (must only see their own).
# The whole point of role B is to try what only A may do.
ROLE_A_USER=instructor_lab
ROLE_A_PASS=Lab-Test-2026!
ROLE_B_USER=aprendiz_lab
ROLE_B_PASS=Lab-Test-2026!

# ---- database --------------------------------------------------------------
# SYNTHETIC ONLY. The production Moodle database holds learners' personal data; the lab's
# own finding L1 was exactly this kind of dump being reachable from the LAN.
DB_IMAGE=postgres:16
DB_NAME=moodle_lab
DB_USER=moodle
DB_PASSWORD=lab_only_not_a_secret

# ---- gate thresholds -------------------------------------------------------
# ALLOW_SECRETS=0 is expected to FAIL on first run: several .env files are committed.
# That failure is the point — the gate exists so a run gets a verdict.
ALLOW_SECRETS=0
MAX_DEP_FINDINGS=40
MAX_SAST_FINDINGS=60
K6_P95_MS=3000
K6_ERR_RATE=0.02

# ---- declared envelope -----------------------------------------------------
PERF_CPUS=4
PERF_MEM=2048m

# ---- runtime recipe parameters (consumed by recipes/*.yml) -----------------
# Moodle plugin: the folder name must equal $plugin->component minus its type prefix,
# or Moodle refuses to install it.
MOODLE_IMAGE=bitnamilegacy/moodle:4.5
PLUGIN_SUBDIR=antiplagio/plugin/antiplagiarsena
PLUGIN_TYPE=local
PLUGIN_DIR=antiplagiarsena
PLUGIN_COMPONENT=local_antiplagiarsena
MOODLE_ADMIN_USER=labadmin
MOODLE_ADMIN_PASS=Lab-Admin-2026!

# FastAPI service
PYTHON_IMAGE=python:3.11-slim
API_SUBDIR=antiplagio/api_antiplagio
API_MODULE=main:app
REQUIREMENTS=antiplagio/requirements.txt
API_HEALTH_PATH=/health

# Shared analyzer -> API secret. Set here so the lab exercises the AUTHENTICATED path;
# leaving it empty is what production must never do (see api_antiplagio/main.py:47).
PROCESS_STATUS_SECRET=lab-only-not-a-production-secret

# DAST alert budget (make gate).
MAX_DAST_FINDINGS=40
