# Runtime .env for the audited FastAPI service INSIDE the lab (never the project's own file).
# Points at the lab database and sets the analyzer->API shared secret, so the audit exercises
# the AUTHENTICATED path. Leaving PROCESS_STATUS_SECRET empty is what the code treats as
# "skip authentication entirely" — see api_antiplagio/main.py:47.
HOST_PG=db
USER_PG=moodle
PASS_PG=lab_only_not_a_secret
PORT_PG=5432
SSID_PG=moodle_lab
SECRET_KEY_PROCESS=lab-only-process-key
SECRET_KEY_EJECUTION=lab-only-execution-key
ALGORITHM=HS256
PROCESS_STATUS_SECRET=lab-only-not-a-production-secret
