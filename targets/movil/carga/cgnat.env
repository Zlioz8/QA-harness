# Uso normal detrás de UNA IP de operador o de sede: 400 personas ya dentro, navegando, todas con
# la misma dirección pública. Pregunta: ¿algún cupo por IP las frena? (No debe: el cupo general
# cuenta por sesión.)
ESCALERA_TIPO=carga
ESCALERA_SCRIPT=sesion.js
ESCALERA_PASOS=400
ESCALERA_RAMPA=30s
ESCALERA_MESETA=3m
ESCALERA_BAJADA=10s
ESCALERA_IPS=aula:1000
