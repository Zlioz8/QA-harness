# Un aula de 40 abre la app sin sesión a la vez, todos desde la misma IP: el límite de 10 logins
# por minuto e IP (auth_router.py:106) deja fuera a 30 en el primer minuto. Es la clase que empieza.
ESCALERA_TIPO=pico
ESCALERA_SCRIPT=pico-login.js
ESCALERA_PASOS=40 120
ESCALERA_MESETA=90s
ESCALERA_PAUSA_S=70
ESCALERA_SIGUE=1
ESCALERA_IPS=aula:40
