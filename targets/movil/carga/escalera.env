# Escalera de carga de Zajuna Móvil contra el despliegue LOCAL. Datos, no código: la lee
# tools/perf-escalera.sh. El entorno del shell gana (ESCALERA_PASOS="25 50" make perf-escalera …).
#
# Cada paso: N personas usando la app a la vez (k6/sesion.js -> k6/modelo.js), 30 s de rampa y
# 3 min de meseta, que es donde se juzga el SLO. Hay 1.000 cuentas sembradas: ese es el tope.
ESCALERA_TIPO=carga
ESCALERA_SCRIPT=sesion.js
ESCALERA_PASOS=25 50 100 200 400 700 1000
ESCALERA_RAMPA=30s
ESCALERA_MESETA=3m
ESCALERA_BAJADA=10s
ESCALERA_PAUSA_S=30
# Dos pasos más allá del primer incumplimiento: en LOCAL interesa ver cómo se degrada.
ESCALERA_SIGUE=2
ESCALERA_IPS=por-vu
