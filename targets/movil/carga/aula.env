# Un aula (o un operador móvil) detrás de una sola IP: 40 personas comparten dirección.
# El límite de la API es por IP y por ruta (auth_router.py:53): aquí es donde se ve.
# Los 429 de esta escalera SON el resultado, no un fallo del instrumento.
ESCALERA_TIPO=carga
ESCALERA_SCRIPT=sesion.js
ESCALERA_PASOS=40 80 160
ESCALERA_RAMPA=20s
ESCALERA_MESETA=2m
ESCALERA_BAJADA=10s
ESCALERA_PAUSA_S=70
ESCALERA_SIGUE=2
ESCALERA_IPS=aula:40
