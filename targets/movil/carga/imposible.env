# El control negativo: un SLO que nadie puede cumplir. Si esta escalera NO se detiene en el
# primer paso, el instrumento no sabe fallar y ninguna de sus otras respuestas vale.
ESCALERA_TIPO=carga
ESCALERA_SCRIPT=sesion.js
ESCALERA_PASOS=3 6
ESCALERA_RAMPA=5s
ESCALERA_MESETA=20s
ESCALERA_BAJADA=5s
ESCALERA_PAUSA_S=2
ESCALERA_IPS=por-vu
SLO_P95_MS=1
