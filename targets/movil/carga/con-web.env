# La app CON la web de Moodle en uso a la vez: la plataforma real no tiene php-fpm para la app sola.
# 60 personas navegan la web (k6/web.js) durante toda la corrida mientras la app sube por pasos.
# Se compara con la escalera normal a los mismos pasos: la diferencia es el techo que se lleva la web.
ESCALERA_TIPO=carga
ESCALERA_SCRIPT=sesion.js
ESCALERA_PASOS=100 200 400
ESCALERA_RAMPA=30s
ESCALERA_MESETA=3m
ESCALERA_BAJADA=10s
ESCALERA_PAUSA_S=30
ESCALERA_SIGUE=1
ESCALERA_IPS=por-vu
ESCALERA_FONDO_VUS=60
