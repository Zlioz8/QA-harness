# Una sede entera (o los clientes de un operador móvil tras CGNAT) detrás de UNA IP: 200 personas.
# Con 40 por IP (carga/aula.env) el límite de 300 peticiones por minuto y ruta no se alcanza;
# con 200, el conteo de notificaciones solo ya pasa de 600 por minuto. Los 429 son el resultado.
ESCALERA_TIPO=carga
ESCALERA_SCRIPT=sesion.js
ESCALERA_PASOS=200
ESCALERA_RAMPA=20s
ESCALERA_MESETA=2m
ESCALERA_BAJADA=10s
ESCALERA_IPS=aula:200
