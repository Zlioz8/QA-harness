# Resistencia: dos horas a una carga que el sistema aguanta con holgura. No busca el quiebre:
# busca lo que solo aparece con el tiempo (memoria que crece, tablas que engordan, conexiones
# que no se devuelven). El número de personas se fija tras la escalera: la mitad de la rodilla.
ESCALERA_TIPO=resistencia
ESCALERA_SCRIPT=sesion.js
ESCALERA_PASOS=100
ESCALERA_RAMPA=1m
ESCALERA_MESETA=2h
ESCALERA_BAJADA=30s
ESCALERA_IPS=por-vu
