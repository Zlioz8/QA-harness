# ============================================================================
# Target profile: costos_web  (Laravel + Vue + PostgreSQL)
# Migrated from the lab's old root .env when the lab was split into core + targets.
#
# ESTE ARCHIVO ES EL CONTRATO DEL PERFIL, NO EL SECRETO. Se versiona: declara qué variables
# existen y qué significa cada una. Los valores reales —el host del despliegue y las
# credenciales de las cuentas de prueba— van en targets/costos_web/target.env.local, que
# .gitignore excluye. Ver la sección `authentication` para el porqué.
#   cp targets/costos_web/target.env.local.example targets/costos_web/target.env.local
# ============================================================================
COMPOSE_PROJECT_NAME=seclab_costos_web
TARGET_NAME=costos_web

# ---- source ----------------------------------------------------------------
SRC_PATH=/opt/MANUALES DE DESPLIEGUE WITH REPORT/SECURITY-LAB/work/repo
REPO_URL=ssh://git@git.fsrisaralda.com:2222/fabrica_zajuna/costos_web.git
BRANCH=CostosWebDev

BACKEND_SUBDIR=CostosWeb2.0_Back
FRONTEND_SUBDIR=CostosWeb2.0_Front
SOURCE_DIRS=CostosWeb2.0_Back,CostosWeb2.0_Front
LANGS=php,js

# ---- static analysis -------------------------------------------------------
# PHP has no community Qodana linter: the release image demands a Qodana Cloud token and
# aborts `make static` before sonar. Declared NOT APPLICABLE (empty = documented skip, not pass).
QODANA_IMAGE=
# Explicit rulesets (--config=auto would require telemetry to be on).
# La última entrada son las reglas propias del laboratorio (lib/semgrep/laravel-vue.yml): modos de
# fallo del framework que los paquetes públicos no conocen. Ver la cabecera de ese archivo.
SEMGREP_CONFIG=--config=p/security-audit --config=p/secrets --config=p/owasp-top-ten --config=/seclab-lib/semgrep/laravel-vue.yml
SONAR_PORT=9000
# Vacío = el lab lo acuña solo tras arrancar el servidor (tools/sonar-token.sh, con las
# credenciales admin de abajo). Rellénalo solo si apuntas a un SonarQube externo ya provisto.
SONAR_TOKEN=
# Credenciales admin del SonarQube que levanta el lab. Defecto de una instalación community
# fresca (admin/admin); el script fija SONAR_NEW_ADMIN_PASS la primera vez porque el server
# obliga a cambiar la de fábrica. No son secretos del PROYECTO auditado: son del contenedor local.
SONAR_ADMIN_USER=admin
SONAR_ADMIN_PASS=admin
SONAR_NEW_ADMIN_PASS=admin01
QODANA_TOKEN=

# ---- runtime ---------------------------------------------------------------
PHP_VERSION=8.4
APP_PORT=8099
# Peldaño 2: el laboratorio apunta a un despliegue de validación ya existente, no a uno que
# levante `make up` — el perfil perdió su compose.runtime.yml en la migración. La dirección de ese
# despliegue es infraestructura interna, así que se declara en target.env.local.
BASE_URL=
APP_INTERNAL_URL=
HEALTH_PATH=/up
FRONTEND_PORT=5173
FRONTEND_URL=
# SPA y API comparten origen en este despliegue, así que el Origin es el propio host.
ALLOWED_ORIGIN=
PROD_PORT=8100

# ---- authentication --------------------------------------------------------
AUTH_ADAPTER=sanctum
#
# LAS CREDENCIALES NO ESTÁN AQUÍ, Y ES DELIBERADO.
#
# Este perfil dejó de apuntar a un stack sintético de localhost para apuntar al despliegue de
# validación, y en ese momento sus cuentas pasaron a ser CUENTAS REALES: una de ellas de dominio
# institucional. La regla que .gitignore ya escribió para el perfil `movil` aplica igual aquí —
# publicar una credencial en un remoto alojado la escribe en el historial para siempre.
#
# Estructura, para que quien retome el perfil sepa qué declarar en target.env.local:
#
#   ROLE_A_USER / ROLE_A_PASS      máximo privilegio    -> lo usa el motor genérico (lib/specs)
#   ROLE_B_USER / ROLE_B_PASS      mínimo privilegio    -> lo usa el motor genérico (lib/specs)
#   ROL1_ADMINISTRADOR_USER/_PASS  las seis cuentas, una por rol, para la matriz específica de
#   ROL2_DELEGADO_USER/_PASS       este proyecto: el motor genérico solo conoce A y B, y este
#   ROL3_DIRECTOR_USER/_PASS       proyecto tiene seis roles con alcances distintos
#   ROL4_SUBDIRECTOR_USER/_PASS
#   ROL5_COORDINADOR_USER/_PASS
#   ROL6_PARTICIPANTE_USER/_PASS
#   ADMIN_EMAIL / ADMIN_PASS       nombres heredados de las specs antiguas de costos_web;
#   REP_EMAIL / REP_PASS           apuntan a las mismas cuentas que ROLE_A_ y ROLE_B_
#
#   COORD_GRUPO_ID                 territorio del coordinador de pruebas, para las
#   COORD_INTEGRANTE_ID            comprobaciones de alcance: qué ve dentro de su grupo y qué
#   FUERA_DE_AMBITO_ID             debe negársele fuera de él
#   COORD_REPRESENTANTE_ID         representante usado por la prueba de los dos formularios
#
# Son identificadores de un volcado real, así que también quedan fuera del repositorio.

# ---- database --------------------------------------------------------------
DB_IMAGE=postgres:17
DB_NAME=audit
DB_USER=postgres
DB_PASSWORD=admin01

# ---- gate thresholds -------------------------------------------------------
ALLOW_SECRETS=0
MAX_DEP_FINDINGS=50
MAX_SAST_FINDINGS=50
K6_P95_MS=1500
K6_ERR_RATE=0.01

# ---- carga (k6) ------------------------------------------------------------
# Script que corre `make perf`. Defecto del core: smoke.js (un VU, humo). La prueba real de
# saturación de este proyecto —el listado con el padrón completo, que reprodujo el OOM— es
# usuarios_load.js. El resto de escenarios están en targets/costos_web/k6/.
K6_SCRIPT=usuarios_load.js
# El host del despliegue es autofirmado (valor real en target.env.local).

# ---- declared envelope (perf numbers are only comparable against this) ------
PERF_CPUS=4
PERF_MEM=1536m

# DAST alert budget (make gate).
MAX_DAST_FINDINGS=40

# Espaciado entre comprobaciones de la matriz: el proyecto limita a 60 peticiones/minuto
# por usuario, y una matriz sin ritmo mide el limitador en vez de la autorización.
E2E_PACE_MS=1100

# ---- presupuesto del hilo principal del navegador (R8 §3.22) ----------------
# Mide y anticipa el congelamiento de la pestaña: lo que ni k6 ni ZAP ven porque
# el servidor está sano y el trabajo caro ocurre dentro del navegador.
# Umbrales alineados con el criterio de verificación de §3.22.
PERF_IMG_TOTAL_KB=2048
PERF_IMG_MAX_KB=300
PERF_IMG_MAX_MPX=8
PERF_TBT_MS=600
PERF_LONGTASK_MS=250
PERF_CPU_THROTTLE=4
PERF_BUDGET_PATH=/
