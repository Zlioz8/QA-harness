# ============================================================================
# Target profile: costos_web  (Laravel + Vue + PostgreSQL)
# Migrated from the lab's old root .env when the lab was split into core + targets.
# ============================================================================
COMPOSE_PROJECT_NAME=seclab_costos_web
TARGET_NAME=costos_web

# ---- source ----------------------------------------------------------------
SRC_PATH=/opt/MANUALES DE DESPLIEGUE WITH REPORT/SECURITY-LAB/work/repo
REPO_URL=ssh://git@git.fsrisaralda.com:2222/fabrica_zajuna/costos_web.git
BRANCH=CostosWebDev

BACKEND_SUBDIR=CostosWeb2.0_Back
FRONTEND_SUBDIR=CostosWeb2.0_Front
SOURCE_DIRS=CostosWeb2.0_Back,CostosWeb2.0_Front
LANGS=php,js

# ---- static analysis -------------------------------------------------------
QODANA_IMAGE=jetbrains/qodana-php:latest
# Explicit rulesets (--config=auto would require telemetry to be on).
SEMGREP_CONFIG=--config=p/security-audit --config=p/secrets --config=p/owasp-top-ten
SONAR_PORT=9000
SONAR_TOKEN=
QODANA_TOKEN=

# ---- runtime ---------------------------------------------------------------
PHP_VERSION=8.4
APP_PORT=8099
BASE_URL=http://localhost:8099
APP_INTERNAL_URL=http://app:8000
HEALTH_PATH=/up
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173
PROD_PORT=8100

# ---- authentication --------------------------------------------------------
AUTH_ADAPTER=sanctum
# Seeded test accounts (must match db-init/02_seed.sql).
ROLE_A_USER=admin@test.local
ROLE_A_PASS=secret123
ROLE_B_USER=rep@test.local
ROLE_B_PASS=secret123
# Legacy names kept so the existing costos_web specs/scripts keep running unchanged.
ADMIN_EMAIL=admin@test.local
ADMIN_PASS=secret123
REP_EMAIL=rep@test.local
REP_PASS=secret123

# ---- database --------------------------------------------------------------
DB_IMAGE=postgres:17
DB_NAME=audit
DB_USER=postgres
DB_PASSWORD=admin01

# ---- gate thresholds -------------------------------------------------------
ALLOW_SECRETS=0
MAX_DEP_FINDINGS=50
MAX_SAST_FINDINGS=50
K6_P95_MS=1500
K6_ERR_RATE=0.01

# ---- declared envelope (perf numbers are only comparable against this) ------
PERF_CPUS=4
PERF_MEM=1536m

# DAST alert budget (make gate).
MAX_DAST_FINDINGS=40
