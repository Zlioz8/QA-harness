# Lab-provided .env for the RUNTIME COPY only (never written back to the project).
# `php artisan serve` forwards these to its request subprocess, so they must be
# correct here (not just in the container OS env). Values match the db service.
APP_NAME=CostosWeb
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=audit
DB_USERNAME=postgres
DB_PASSWORD=admin01

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
BCRYPT_ROUNDS=12

# Treat these origins/hosts as the SPA so Sanctum uses the session cookie.
SANCTUM_STATEFUL_DOMAINS=localhost:8099,127.0.0.1:8099,localhost:8000,127.0.0.1:8000,localhost:5173
SESSION_SECURE_COOKIE=false
