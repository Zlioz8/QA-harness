# Plantilla del override local del perfil costos_web.
#
#   cp target.env.local.example target.env.local     y rellena los valores
#
# target.env.local NO se versiona (.gitignore: targets/*/target.env.local). Es el único sitio
# donde viven la dirección del despliegue de validación y las credenciales de las cuentas de
# prueba. El target.env de al lado documenta qué significa cada variable.
#
# Se carga ENCIMA de target.env: el Makefile pasa los dos --env-file a docker compose (el último
# gana), los servicios lo declaran como env_file opcional, y tools/lib-env.sh lo consulta primero.
# Sin este archivo el perfil sigue siendo válido: las dimensiones [code] corren igual, y las
# [live] se detienen en require-live con un BASE_URL vacío en vez de fingir que pasaron.

# ---- runtime ---------------------------------------------------------------
BASE_URL=https://
APP_INTERNAL_URL=https://
FRONTEND_URL=https://
ALLOWED_ORIGIN=https://

# ---- authentication --------------------------------------------------------
# A = máximo privilegio, B = mínimo privilegio de los que alcanzan el área administrativa.
ROLE_A_USER=
ROLE_A_PASS=
ROLE_B_USER=
ROLE_B_PASS=

# Las seis cuentas, una por rol, para la matriz específica de este proyecto
# (el motor genérico de lib/specs solo conoce A y B).
ROL1_ADMINISTRADOR_USER=
ROL1_ADMINISTRADOR_PASS=
ROL2_DELEGADO_USER=
ROL2_DELEGADO_PASS=
ROL3_DIRECTOR_USER=
ROL3_DIRECTOR_PASS=
ROL4_SUBDIRECTOR_USER=
ROL4_SUBDIRECTOR_PASS=
ROL5_COORDINADOR_USER=
ROL5_COORDINADOR_PASS=
ROL6_PARTICIPANTE_USER=
ROL6_PARTICIPANTE_PASS=

# Nombres heredados que usan las specs antiguas de costos_web; mismas cuentas que ROLE_A_/ROLE_B_.
ADMIN_EMAIL=
ADMIN_PASS=
REP_EMAIL=
REP_PASS=

# ---- identificadores del volcado de validación -----------------------------
# Territorio del coordinador de pruebas, para las comprobaciones de alcance.
COORD_GRUPO_ID=
COORD_INTEGRANTE_ID=
FUERA_DE_AMBITO_ID=
COORD_REPRESENTANTE_ID=
